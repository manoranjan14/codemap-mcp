# Local only. Never commit. Never paste the value below into a chat,
# a commit message, an issue, or a CI log.
#
# Create the token at https://pypi.org/manage/account/token/ and scope it
# to the codemap-mcp project, not to the whole account.

TWINE_USERNAME=__token__
TWINE_PASSWORD=pypi-REPLACE_WITH_YOUR_TOKEN

# For a dry run against TestPyPI, swap in a TestPyPI token and set:
# TWINE_REPOSITORY_URL=https://test.pypi.org/legacy/
